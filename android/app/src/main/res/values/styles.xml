<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="KalisLaunchBase" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/launch_background_color</item>
        <item name="android:navigationBarColor">@color/launch_background_color</item>
    </style>
    <style name="LaunchTheme" parent="@style/KalisLaunchBase" />
    <!-- Même fond pendant la transition vers la première image Flutter. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background_color</item>
    </style>
</resources>
